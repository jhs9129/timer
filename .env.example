# apps/api (copy to apps/api/.env)
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://village:village@localhost:5432/village
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# auth: generate SESSION_SECRET with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_SECRET=dev-secret-change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
DEV_LOGIN_ENABLED=true

# cron (cron-job.org sends this as the X-Cron-Secret header)
CRON_SECRET=dev-cron-secret

# apps/web (copy to apps/web/.env)
VITE_API_URL=http://localhost:8000
